{
  "mcpServers": {
    "modelscope-mcp-hub": {
      "command": "node",
      "args": [
        "./mcp/server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "NODE_EXTRA_CA_CERTS",
        "SSL_CERT_FILE"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 60
    }
  }
}
